# Copy this file to .env and fill in what you have. Everything is optional for local dev.
# Never put real keys in this file: it is a template and is NOT git-ignored. Real values go in .env.

# Port the API listens on.
PORT=8787

# Tiger Data (Postgres) connection string. Leave empty to use a local embedded database (~/.out-of-bounds/pglite).
DATABASE_URL=

# Set to true to require full TLS certificate verification for DATABASE_URL.
DB_SSL_VERIFY=false

# Google AI Studio key. Leave empty to turn off photo verification and AI quest tips.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Most Gemini calls (photo checks + quest tips) per day.
GEMINI_DAILY_LIMIT=300

# Team password: players who enter it in Profile get team powers (check in anywhere on the shared map,
# simulate rivals, reset turf). Use a long random value and share it privately.
TEAM_KEY=

# Lets everyone else check in without GPS. Those stamps only show up for them, never on the shared turf map.
VISITOR_MODE=true

# Gives EVERY player team powers. Set to true for local development; never on a public site.
ALLOW_DEMO=false
