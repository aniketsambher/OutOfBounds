# Copy this file to .env and fill in what you have. Everything is optional for local dev.
# Never put real keys in this file: it is a template and is NOT git-ignored. Real values go in .env.

# Port the API listens on.
PORT=8787

# Tiger Data (Postgres) connection string. Leave empty to use a local embedded database (~/.out-of-bounds/pglite).
DATABASE_URL=

# Set to true to require full TLS certificate verification for DATABASE_URL.
DB_SSL_VERIFY=false

# Google AI Studio key. Leave empty to turn off photo verification and AI quest tips.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Allow check-ins without GPS (demo mode) and the "simulate rival" button. Set to false for real play.
ALLOW_DEMO=true
